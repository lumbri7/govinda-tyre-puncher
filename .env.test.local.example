# End to end tests run against a REAL Supabase project.
# Copy to .env.test.local, fill it in with a throwaway project, and run
# `npm run test:e2e`. Every test creates its own shop, owner and employees, so
# it is safe to point at a project that only exists for testing.
#
# Use a separate project from production: the tests deliberately try to break
# row level security, and they create (and disable) accounts.

NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The elevated key. Projects created before the rename use
# SUPABASE_SERVICE_ROLE_KEY instead; either name works.
SUPABASE_SECRET_KEY=sb_secret_...

# The tests need a project with no shop set up yet: they call bootstrap_owner to
# create the owner and the shop, which refuses to run twice. Authentication ->
# Providers -> Email only; Phone stays off, because employee logins are the same
# internal addresses the app generates.

# Set this when the test project ALREADY has a shop, so bootstrap_owner cannot
# run. The fixtures are then written straight to the tables with the elevated key
# and removed again by the global teardown. Leave it unset for a fresh project,
# where the tests create the owner and the shop through bootstrap_owner as a real
# first run would.
# E2E_FIXTURE_MODE=service_role

# Point at an already running dev server instead of letting Playwright start one
# E2E_BASE_URL=http://localhost:3000
