# ---------------------------------------------------------------------------
# Copy to .env.local and fill in the values from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
# ---------------------------------------------------------------------------

# Project URL, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. RLS protects every read and write with this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server only. Bypasses row level security: never expose it to the browser and
# never commit it. Rotating it is safe (it is only used for admin operations).
#
# Projects created before the rename still call this SUPABASE_SERVICE_ROLE_KEY;
# the app accepts either name and prefers SUPABASE_SECRET_KEY when both are set.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Public site URL, used to build password reset links. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Nothing to switch on for employee sign in. Turn on Authentication -> Providers
# -> Email for the shop owner, and leave Phone off: employees sign in with their
# mobile number and a password, and the app resolves the number to the generated
# employee-<uuid>@auth.govindatyrepuncture.internal address on the server. No
# SMS provider, OTP service or billing account is involved.
# ---------------------------------------------------------------------------